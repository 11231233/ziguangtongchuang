define_attribute {p:host_rx} {PAP_IO_LOC} {Y12}
define_attribute {p:host_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:host_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:host_rx} {PAP_IO_PULLUP} {TRUE}
define_attribute {p:host_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:host_tx} {PAP_IO_LOC} {W12}
define_attribute {p:host_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:host_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:host_tx} {PAP_IO_DRIVE} {4}
define_attribute {p:host_tx} {PAP_IO_SLEW} {SLOW}
